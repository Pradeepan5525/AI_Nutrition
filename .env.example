# Application Environment (development | production)
ENVIRONMENT=development

# Security & Cryptography (Must be changed to 32+ random characters in production)
JWT_SECRET_KEY=clinical-ai-nutrition-super-secret-key-production-grade-2026
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30

# Database Connection (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./data/processed/nutrition_app.db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional demo user creation credentials (for scripts/create_demo_user.py)
DEMO_USER_EMAIL=patient@example.com
DEMO_USER_PASSWORD=DemoPassword123!
DEMO_USER_NAME=Alex Carter
